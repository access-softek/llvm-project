// RUN: mlir-translate --import-dxbc-hex %s | FileCheck %s
// RUN: mlir-translate --import-dxbc-hex %s | mlir-opt --verify-roundtrip

// CHECK:      dxbc.module {

// CHECK-NEXT:   dxbc.sincos r<0>, r<1>, r<2>
0x0700004d, 0x001000f2, 0x00000000, 0x001000f2, 0x00000001, 0x00100e46, 0x00000002

// CHECK-NEXT:   dxbc.sincos_sat r<0>, r<1>, r<2>
0x0700204d, 0x001000f2, 0x00000000, 0x001000f2, 0x00000001, 0x00100e46, 0x00000002

// CHECK-NEXT:   dxbc.sincos null, r<1>, r<2>
0x0600004d, 0x0000d000, 0x001000f2, 0x00000001, 0x00100e46, 0x00000002

// CHECK-NEXT:   dxbc.sincos r<0>, null, r<2>
0x0600004d, 0x001000f2, 0x00000000, 0x0000d000, 0x00100e46, 0x00000002

// CHECK-NEXT:   dxbc.sincos r<0>, r<1>, -r<2>
0x0800004d, 0x001000f2, 0x00000000, 0x001000f2, 0x00000001, 0x80100e46, 0x00000041, 0x00000002

// CHECK-NEXT:   dxbc.sincos precise <x, y, z, w> r<0>, r<1>, r<2>
0x0778004d, 0x001000f2, 0x00000000, 0x001000f2, 0x00000001, 0x00100e46, 0x00000002

// CHECK-NEXT:   dxbc.sincos_sat precise <x> r<0>, r<1>, r<2>
0x0788204d, 0x001000f2, 0x00000000, 0x001000f2, 0x00000001, 0x00100e46, 0x00000002

// CHECK-NEXT: }
