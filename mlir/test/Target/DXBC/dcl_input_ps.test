// RUN: mlir-translate --import-dxbc-bin %S/inputs/dcl_input_ps.bin | FileCheck %s

// CHECK-LABEL: module
module {
  // dcl_input_ps constant v0.x
  // CHECK:      %0 = dxbc.index.imm {imm = 0 : i32}
  // CHECK-NEXT: %1 = dxbc.operand %0 {mask = 16 : i32, num_components = 4 : i32, type = 1 : i32}
  // CHECK-NEXT: dxbc.dcl_input_ps constant %1

  // dcl_input_ps linear v1.x
  // CHECK-NEXT: %2 = dxbc.index.imm {imm = 1 : i32}
  // CHECK-NEXT: %3 = dxbc.operand %2 {mask = 16 : i32, num_components = 4 : i32, type = 1 : i32}
  // CHECK-NEXT: dxbc.dcl_input_ps linear %3

  // dcl_input_ps linearCentroid v2.x
  // CHECK-NEXT: %4 = dxbc.index.imm {imm = 2 : i32}
  // CHECK-NEXT: %5 = dxbc.operand %4 {mask = 16 : i32, num_components = 4 : i32, type = 1 : i32}
  // CHECK-NEXT: dxbc.dcl_input_ps linearCentroid %5

  // dcl_input_ps linearNoPerspective v3.x
  // CHECK-NEXT: %6 = dxbc.index.imm {imm = 3 : i32}
  // CHECK-NEXT: %7 = dxbc.operand %6 {mask = 16 : i32, num_components = 4 : i32, type = 1 : i32}
  // CHECK-NEXT: dxbc.dcl_input_ps linearNoPerspective %7

  // dcl_input_ps linearNoPerspectiveCentroid v4.x
  // CHECK-NEXT: %8 = dxbc.index.imm {imm = 4 : i32}
  // CHECK-NEXT: %9 = dxbc.operand %8 {mask = 16 : i32, num_components = 4 : i32, type = 1 : i32}
  // CHECK-NEXT: dxbc.dcl_input_ps linearNoPerspectiveCentroid %9

  // dcl_input_ps linearSample v5.x
  // CHECK-NEXT: %10 = dxbc.index.imm {imm = 5 : i32}
  // CHECK-NEXT: %11 = dxbc.operand %10 {mask = 16 : i32, num_components = 4 : i32, type = 1 : i32}
  // CHECK-NEXT: dxbc.dcl_input_ps linearSample %11

  // dcl_input_ps linearNoPerspectiveSample v6.x
  // CHECK-NEXT: %12 = dxbc.index.imm {imm = 6 : i32}
  // CHECK-NEXT: %13 = dxbc.operand %12 {mask = 16 : i32, num_components = 4 : i32, type = 1 : i32}
  // CHECK-NEXT: dxbc.dcl_input_ps linearNoPerspectiveSample %13
}
