// RUN: mlir-translate --import-dxbc-bin %S/inputs/dcl_global_flags.bin | FileCheck %s

// 9 individual flags (one per instruction), then multi-flag combo, then all flags.

// CHECK:      module {
// CHECK-NEXT:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK-NEXT:   dxbc.dcl_global_flags <enableDoublePrecision>
// CHECK-NEXT:   dxbc.dcl_global_flags <forceEarlyDepth>
// CHECK-NEXT:   dxbc.dcl_global_flags <enableRawStructured>
// CHECK-NEXT:   dxbc.dcl_global_flags <skipOptimization>
// CHECK-NEXT:   dxbc.dcl_global_flags <enableMinPrecision>
// CHECK-NEXT:   dxbc.dcl_global_flags <enableDoubleExtensions>
// CHECK-NEXT:   dxbc.dcl_global_flags <enableShaderExtensions>
// CHECK-NEXT:   dxbc.dcl_global_flags <allResourcesBound>
// CHECK-NEXT:   dxbc.dcl_global_flags <refactoringAllowed|skipOptimization|allResourcesBound>
// CHECK-NEXT:   dxbc.dcl_global_flags <refactoringAllowed|enableDoublePrecision|forceEarlyDepth|enableRawStructured|skipOptimization|enableMinPrecision|enableDoubleExtensions|enableShaderExtensions|allResourcesBound>
// CHECK-NEXT: }
