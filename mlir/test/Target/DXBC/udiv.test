// RUN: mlir-translate --import-dxbc-bin %S/inputs/udiv.bin | FileCheck %s
// udiv NULL, r0.x, vOutputControlPointID, 4

// CHECK:      dxbc.module {
// CHECK-NEXT:   %0 = dxbc.operand {num_components = 0 : i32, type = 13 : i32}
// CHECK-NEXT:   %1 = dxbc.index.imm {imm = 0 : i32}
// CHECK-NEXT:   %2 = dxbc.operand %1 {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK-NEXT:   %3 = dxbc.operand  {num_components = 1 : i32, type = 22 : i32}
// CHECK-NEXT:   %4 = dxbc.operand.imm {imm = dense<4> : vector<1xi32>}
// CHECK-NEXT:   dxbc.instruction "udiv" %0, %2, %3, %4
// CHECK-NEXT: }
