// CHECK:         dxbc.dcl_temps 3
// CHECK:         dxbc.dcl_tgsm_raw g<0>, 1024
// CHECK:         dxbc.dcl_thread_group <x = 4, y = 2, z = 3>
// CHECK:         dxbc.ishl r<0, <x>>, vThreadIDInGroup<<z>>, l(0x2)
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 48 : i32, num_components = 4 : i32, type = 31 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]], %[[INDEX_3]] {num_components = 4 : i32, swizzle = dense<[3, 2, 1, 0]> : vector<4xi32>, type = 8 : i32}
// CHECK:         dxbc.instruction "store_raw" %[[OPERAND_0]], %[[OPERAND_1]], %[[OPERAND_2]]
// CHECK:         dxbc.sync <tgsm>
// CHECK:         dxbc.sync <uav_group>
// CHECK:         dxbc.sync <uav_global>
// CHECK:         dxbc.sync <tgsm|threads>
// CHECK:         dxbc.sync <uav_group|threads>
// CHECK:         dxbc.sync <uav_global|threads>
// CHECK:         dxbc.sync <uav_group|tgsm>
// CHECK:         dxbc.sync <uav_global|tgsm>
// CHECK:         dxbc.sync <uav_group|tgsm|threads>
// CHECK:         dxbc.sync <uav_global|tgsm|threads>
// CHECK:         %[[INDEX_4:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_4]] {mask = 80 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_5:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxbc.operand %[[INDEX_5]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_6:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_5:.*]] = dxbc.operand %[[INDEX_6]] {num_components = 4 : i32, swizzle = dense<[2, 0, 3, 1]> : vector<4xi32>, type = 31 : i32}
// CHECK:         dxbc.instruction "ld_raw" %[[OPERAND_3]], %[[OPERAND_4]], %[[OPERAND_5]]
// CHECK:         dxbc.imm_atomic_iadd r<2, <x>>, g<0>, r<1, <x, y, x, x>>, vThreadIDInGroup<<x>>
// CHECK:         dxbc.atomic_or g<0>, r<1, <x, y, x, x>>, vThreadIDInGroup<<x>>
// CHECK:         dxbc.atomic_cmp_store g<0>, r<1, <x, y, x, x>>, vThreadIDInGroup<<y>>, vThreadIDInGroup<<x>>
// CHECK:         dxbc.imm_atomic_cmp_exch r<1, <x>>, g<0>, r<1, <x, y, x, x>>, vThreadIDInGroup<<y>>, vThreadIDInGroup<<x>>
