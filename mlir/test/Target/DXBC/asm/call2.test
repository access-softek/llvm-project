// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {num_components = 4 : i32, one = 0 : i32, type = 1 : i32}
// CHECK:         dxbc.instruction "switch" %[[OPERAND_0]]
// CHECK:         dxbc.case l(0x1)
// CHECK:         dxbc.call label<2>
// CHECK:         dxbc.callc_nz r<0, <y>>, label<1>
// CHECK:         dxbc.break
// CHECK:         dxbc.default
