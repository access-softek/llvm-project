// CHECK:         dxbc.break
// CHECK:         dxbc.case l(0x2)
// CHECK:         dxbc.break
// CHECK:         dxbc.endswitch
// CHECK:         dxbc.add o<0, <x>>, r<0, <x>>, l(0x3F800000)
// CHECK:         dxbc.ret
