// RUN: mlir-translate --import-dxbc-hex %s | FileCheck %s
// RUN: mlir-translate --import-dxbc-hex %s | mlir-opt --verify-roundtrip

// CHECK:      module {
// CHECK-NEXT:   dxbc.dcl_thread_group <x = 1, y = 1, z = 1>
0x0400009b, 0x00000001, 0x00000001, 0x00000001
// CHECK-NEXT:   dxbc.dcl_thread_group <x = 1024, y = 1, z = 1>
0x0400009b, 0x00000400, 0x00000001, 0x00000001
// CHECK-NEXT:   dxbc.dcl_thread_group <x = 1, y = 1024, z = 1>
0x0400009b, 0x00000001, 0x00000400, 0x00000001
// CHECK-NEXT:   dxbc.dcl_thread_group <x = 1, y = 1, z = 64>
0x0400009b, 0x00000001, 0x00000001, 0x00000040
// CHECK-NEXT: }
