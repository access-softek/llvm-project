// RUN: mlir-translate --import-dxbc-bin %S/inputs/uav_typed_load_store2.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxbc.dcl_uav_typed <id = 3, dim =  buffer>, <x =  sint, y =  sint, z =  sint, w =  sint>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <x>>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <y>>
// CHECK:         dxbc.dcl_output o<0, <x, y, z>>
// CHECK:         dxbc.dcl_temps 5
// CHECK:         dxbc.ld_uav_typed r<0, min16i, <x, y, z>>, v<0, <y, y, y, y>>, u<3, vector>
// CHECK:         dxbc.ld_uav_typed r<1, min16i, <x, y, z>>, v<0, <x, x, x, x>>, u<3, vector>
// CHECK:         dxbc.iadd r<2, <x, y, z>>, r<0, min16i, <x, y, z, x>>, r<1, min16i, <x, y, z, x>>
// CHECK:         dxbc.ld_uav_typed_s null, v<0, <y, y, y, y>>, u<3, vector, <w, y, z, x>>, r<3, <x>>
// CHECK:         dxbc.ld_uav_typed_s r<0, min16i, <x, y, z>>, v<0, <x, x, x, x>>, u<3, vector, <w, y, z, x>>, r<4, <x>>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 128 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.iadd r<2, <x, y, z>>, r<2, <w, w, w, w>>, r<2, <x, y, z, x>>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {mask = 128 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 4 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_2]], %[[OPERAND_3]]
// CHECK:         dxbc.iadd r<2, <x, y, z>>, r<0, min16i, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxbc.iadd r<2, <x, y, z>>, r<2, <w, w, w, w>>, r<2, <x, y, z, x>>
// CHECK:         %[[INDEX_4:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxbc.operand %[[INDEX_4]] {mask = 240 : i32, num_components = 4 : i32, type = 30 : i32}
// CHECK:         %[[INDEX_5:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_5:.*]] = dxbc.operand %[[INDEX_5]] {num_components = 4 : i32, swizzle = dense<1> : vector<4xi32>, type = 1 : i32}
// CHECK:         %[[INDEX_6:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_6:.*]] = dxbc.operand %[[INDEX_6]] {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 0]> : vector<4xi32>, type = 0 : i32}
// CHECK:         dxbc.instruction "store_uav_typed" %[[OPERAND_4]], %[[OPERAND_5]], %[[OPERAND_6]]
// CHECK:         dxbc.mov o<0, <x, y, z>>, r<2, <x, y, z, x>>
// CHECK:         dxbc.ret

