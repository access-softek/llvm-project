// RUN: mlir-translate --import-dxbc-bin %S/inputs/srv_ms_load1.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.unknown <tokens = [0x04002058, 0x00107000, 0x00000003, 0x00005555]>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <z>>
// CHECK:         dxbc.dcl_input_ps  constant v<1, <x, y>>
// CHECK:         dxbc.dcl_output o<0, <x, y, z>>
// CHECK:         dxbc.dcl_temps 4
// CHECK:         dxbc.mov r<0, <x, y>>, v<1, <x, y, x, x>>
// CHECK:         dxbc.mov r<0, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxbc.ld2dms r<0, <x, y, z>>, r<0>, t<3, vector>, l(0x0)
// CHECK:         dxbc.mov r<1, <x, y>>, v<0, <x, y, x, x>>
// CHECK:         dxbc.mov r<1, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxbc.ld2dms r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>
// CHECK:         dxbc.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxbc.ld2dms r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, <u = -5, v = 7, w = 0>
// CHECK:         dxbc.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxbc.ld2dms_s r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, r<3, <x>>, <u = -5, v = 7, w = 0>
// CHECK:         dxbc.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 128 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.utof r<0, <w>>, r<0, <w>>
// CHECK:         dxbc.add r<0, <x, y, z>>, r<0, <w, w, w, w>>, r<0, <x, y, z, x>>
// CHECK:         dxbc.ld2dms_s r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, r<3, <x>>
// CHECK:         dxbc.ld2dms r<1, <x, y, z>>, r<1>, t<3, vector>, l(0xD)
// CHECK:         dxbc.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {mask = 128 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_2]], %[[OPERAND_3]]
// CHECK:         dxbc.utof r<0, <w>>, r<0, <w>>
// CHECK:         dxbc.add r<0, <x, y, z>>, r<0, <w, w, w, w>>, r<0, <x, y, z, x>>
// CHECK:         dxbc.add o<0, <x, y, z>>, r<1, <x, y, z, x>>, r<0, <x, y, z, x>>
// CHECK:         dxbc.ret

