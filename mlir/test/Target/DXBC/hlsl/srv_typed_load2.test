// RUN: mlir-translate --import-dxbc-bin %S/inputs/srv_typed_load2.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_resource <id = 3>, <dim =  buffer>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <x>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 3
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 240 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, swizzle = dense<0> : vector<4xi32>, type = 1 : i32}
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 3]> : vector<4xi32>, type = 7 : i32}
// CHECK:         dxbc.instruction "ld" %[[OPERAND_0]], %[[OPERAND_1]], %[[OPERAND_2]]
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {mask = 240 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_4:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxbc.operand %[[INDEX_4]] {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_5:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_5:.*]] = dxbc.operand %[[INDEX_5]] {num_components = 4 : i32, swizzle = dense<0> : vector<4xi32>, type = 1 : i32}
// CHECK:         %[[INDEX_6:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_6:.*]] = dxbc.operand %[[INDEX_6]] {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 3]> : vector<4xi32>, type = 7 : i32}
// CHECK:         dxbc.instruction "ld_s" %[[OPERAND_3]], %[[OPERAND_4]], %[[OPERAND_5]], %[[OPERAND_6]]
// CHECK:         dxbc.mad r<0>, r<0>, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r<1>
// CHECK:         %[[INDEX_7:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_7:.*]] = dxbc.operand %[[INDEX_7]] {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_8:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_8:.*]] = dxbc.operand %[[INDEX_8]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_7]], %[[OPERAND_8]]
// CHECK:         dxbc.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxbc.add o<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxbc.ret

