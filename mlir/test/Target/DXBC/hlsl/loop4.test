// RUN: mlir-translate --import-dxbc-bin %S/inputs/loop4.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x>>
// CHECK:         dxbc.dcl_input_ps  constant v<1, <x, z>>
// CHECK:         dxbc.dcl_output o<0, <x>>
// CHECK:         dxbc.dcl_temps 3
// CHECK:         dxbc.mov r<0, <y, z>>, l(0x0, 0x5, 0x7, 0x0)
// CHECK:         dxbc.mov r<1, <y>>, v<1, <z>>
// CHECK:         dxbc.mov r<1, <x>>, l(0x0)
// CHECK:         dxbc.mov r<0, <w>>, l(0x0)
// CHECK:         dxbc.loop
// CHECK:         dxbc.ige r<1, <z>>, r<1, <x>>, v<1, <x>>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {num_components = 4 : i32, one = 2 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "breakc" %[[OPERAND_0]]
// CHECK:         dxbc.ieq r<1, <z>>, r<1, <y>>, l(0x5)
// CHECK:         dxbc.iadd r<0, <x>>, r<1, <x>>, l(0x1)
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {mask = 48 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {num_components = 4 : i32, swizzle = dense<2> : vector<4xi32>, type = 0 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, swizzle = dense<[1, 0, 1, 1]> : vector<4xi32>, type = 0 : i32}
// CHECK:         %[[INDEX_4:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxbc.operand %[[INDEX_4]] {num_components = 4 : i32, swizzle = dense<[1, 0, 1, 1]> : vector<4xi32>, type = 0 : i32}
// CHECK:         dxbc.instruction "movc" %[[OPERAND_1]], %[[OPERAND_2]], %[[OPERAND_3]], %[[OPERAND_4]]
// CHECK:         dxbc.mov r<1, <x, y>>, r<2, <y, x, y, y>>
// CHECK:         %[[INDEX_5:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_5:.*]] = dxbc.operand %[[INDEX_5]] {num_components = 4 : i32, one = 2 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "continuec" %[[OPERAND_5]]
// CHECK:         dxbc.ieq r<1, <z>>, r<1, <y>>, l(0x7)
// CHECK:         %[[INDEX_6:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_6:.*]] = dxbc.operand %[[INDEX_6]] {num_components = 4 : i32, one = 2 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "if" %[[OPERAND_6]]
// CHECK:         dxbc.mov r<1, <x, y>>, r<0, <x, z, x, x>>
// CHECK:         dxbc.continue
// CHECK:         dxbc.endif
// CHECK:         dxbc.add r<0, <w>>, r<0, <w>>, v<0, <x>>
// CHECK:         dxbc.iadd r<1, <x>>, r<1, <x>>, l(0x1)
// CHECK:         dxbc.endloop
// CHECK:         dxbc.mov o<0, <x>>, r<0, <w>>
// CHECK:         dxbc.ret

