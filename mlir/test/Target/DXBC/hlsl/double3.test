// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed|enableDoublePrecisionFloatOps>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <z, w>>
// CHECK:         dxbc.dcl_input_ps  constant v<1, <x, y>>
// CHECK:         dxbc.dcl_output o<0, <x>>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.mov r<0>, v<0>
// CHECK:         dxbc.deq r<1, <x>>, r<0, <z, w, z, w>>, r<0, <x, y, x, y>>
// CHECK:         dxbc.mov r<1, <z, w>>, v<1, <x, x, x, y>>
// CHECK:         dxbc.dne r<1, <y>>, r<0, <x, y, x, y>>, r<1, <z, w, z, w>>
// CHECK:         dxbc.and r<1, <x>>, r<1, <y>>, r<1, <x>>
// CHECK:         dxbc.dlt r<1, <y>>, r<0, <z, w, z, w>>, r<1, <z, w, z, w>>
// CHECK:         dxbc.dmul r<0, <z, w>>, r<0, <z, w, z, w>>, r<1, <z, w, z, w>>
// CHECK:         dxbc.dadd r<0, <z, w>>, r<0, <z, w, z, w>>, r<0, <x, y, x, y>>
// CHECK:         dxbc.dlt r<0, <x>>, r<0, <x, y, x, y>>, r<0, <z, w, z, w>>
// CHECK:         dxbc.and r<0, <y>>, r<1, <y>>, r<1, <x>>
// CHECK:         dxbc.and o<0, <x>>, r<0, <x>>, r<0, <y>>
// CHECK:         dxbc.ret

