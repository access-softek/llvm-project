// CHECK:         dxbc.dcl_input_ps  constant v<1, <x, y, z>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.f32tof16 r<0>, v<0, <x, x, y, w>>
// CHECK:         dxbc.utof r<0>, r<0>
// CHECK:         dxbc.f16tof32 r<1>, v<1, <z, y, x, x>>
// CHECK:         dxbc.add o<0>, r<0>, r<1>
// CHECK:         dxbc.ret

