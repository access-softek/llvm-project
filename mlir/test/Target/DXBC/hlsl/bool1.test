// RUN: mlir-translate --import-dxbc-bin %S/inputs/bool1.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <x>>
// CHECK:         dxbc.dcl_output o<0, <x>>
// CHECK:         dxbc.dcl_temps 1
// CHECK:         dxbc.firstbit_hi r<0, <x>>, v<0, <x>>
// CHECK:         dxbc.iadd r<0, <x>>, -r<0, <x>>, l(0x1F)
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 16 : i32, num_components = 4 : i32, type = 2 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 1 : i32}
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand.imm {imm = dense<-1> : vector<1xi32>}
// CHECK:         dxbc.instruction "movc" %[[OPERAND_0]], %[[OPERAND_1]], %[[OPERAND_2]], %[[OPERAND_3]]
// CHECK:         dxbc.ret

