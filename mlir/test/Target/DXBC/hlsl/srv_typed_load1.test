// RUN: mlir-translate --import-dxbc-bin %S/inputs/srv_typed_load1.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_resource <id = 3>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x, y, z>>
// CHECK:         dxbc.dcl_input_ps  linear v<1, <x, y>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 5
// CHECK:         dxbc.ftou r<0, <x, y>>, v<1, <x, y, x, x>>
// CHECK:         dxbc.mov r<0, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxbc.unknown <tokens = [0x8900002D, 0x800000C2, 0x00155543, 0x001000F2, 0x00000000, 0x00100E46, 0x00000000, 0x00107E46, 0x00000003]>
// CHECK:         dxbc.ftoi r<1>, v<0, <x, y, z, z>>
// CHECK:         dxbc.unknown <tokens = [0x8900002D, 0x800000C2, 0x00155543, 0x001000F2, 0x00000002, 0x00100F46, 0x00000001, 0x00107E46, 0x00000003]>
// CHECK:         dxbc.add r<0>, r<0>, r<2>
// CHECK:         dxbc.unknown <tokens = [0x8A00002D, 0x8000F601, 0x800000C2, 0x00155543, 0x001000F2, 0x00000002, 0x00100F46, 0x00000001, 0x00107E46, 0x00000003]>
// CHECK:         dxbc.add r<0>, r<0>, r<2>
// CHECK:         dxbc.unknown <tokens = [0x8C0000DF, 0x8000F601, 0x800000C2, 0x00155543, 0x001000F2, 0x00000002, 0x00100012, 0x00000003, 0x00100F46, 0x00000001, 0x00107E46, 0x00000003]>
// CHECK:         dxbc.unknown <tokens = [0x8B0000DF, 0x800000C2, 0x00155543, 0x001000F2, 0x00000001, 0x00100012, 0x00000004, 0x00100E46, 0x00000001, 0x00107E46, 0x00000003]>
// CHECK:         dxbc.add r<0>, r<0>, r<2>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.utof r<2, <x>>, r<2, <x>>
// CHECK:         dxbc.add r<0>, r<0>, r<2, <x, x, x, x>>
// CHECK:         dxbc.add r<0>, r<1>, r<0>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 4 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_2]], %[[OPERAND_3]]
// CHECK:         dxbc.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxbc.add o<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxbc.ret

