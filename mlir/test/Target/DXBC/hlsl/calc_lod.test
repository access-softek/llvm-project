// CHECK:         dxbc.lod r<0, <x>>, v<0, <x, y, x, x>>, t<0, vector, <x>>, s<0>
// CHECK:         dxbc.lod r<0, <y>>, v<0, <x, y, x, x>>, t<1, vector, <x>>, s<0>
// CHECK:         dxbc.add r<0, <x>>, r<0, <y>>, r<0, <x>>
