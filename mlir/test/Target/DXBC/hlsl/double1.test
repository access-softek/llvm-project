// RUN: mlir-translate --import-dxbc-bin %S/inputs/double1.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed|enableDoublePrecisionFloatOps|enableDoubleExtensions>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <z, w>>
// CHECK:         dxbc.dcl_output o<0, <x, y>>
// CHECK:         dxbc.dcl_temps 1
// CHECK:         dxbc.mov r<0>, v<0>
// CHECK:         dxbc.ddiv r<0, <x, y>>, r<0, <z, w, z, w>>, r<0, <x, y, x, y>>
// CHECK:         dxbc.dadd r<0, <z, w>>, r<0, <z, w, z, w>>, d(0x0, 0x60000000C0116666)
// CHECK:         dxbc.dmin r<0, <x, y>>, r<0, <x, y, x, y>>, d(0x800000003FFC51EB, 0x0)
// CHECK:         dxbc.dmax r<0, <x, y>>, r<0, <z, w, z, w>>, r<0, <x, y, x, y>>
// CHECK:         dxbc.dmov r<0, <x, y>>, |r<0, <x, y, x, y>>|
// CHECK:         dxbc.mov o<0, <x, y>>, r<0, <x, y, x, x>>
// CHECK:         dxbc.ret

