// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 32 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.utof r<0, <y>>, r<0, <y>>
// CHECK:         dxbc.mad r<0>, r<0, <y, y, y, y>>, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r<0, <x, x, x, x>>
// CHECK:         dxbc.ftou r<1, <x>>, r<0, <w>>
// CHECK:         dxbc.mov o<0>, r<0>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {mask = 240 : i32, num_components = 4 : i32, type = 30 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 1 : i32, type = 1 : i32}
// CHECK:         %[[INDEX_4:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxbc.operand %[[INDEX_4]] {num_components = 4 : i32, swizzle = dense<0> : vector<4xi32>, type = 0 : i32}
// CHECK:         dxbc.instruction "store_raw" %[[OPERAND_2]], %[[OPERAND_3]], %[[OPERAND_4]]
// CHECK:         dxbc.ret

