// CHECK:         dxbc.dcl_input_ps  constant v<0, <y>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.unknown <tokens = [0x890000A5, 0x800002C2, 0x00199983, 0x00100012, 0x00000000, 0x0010100A, 0x00000000, 0x0011E006, 0x00000003]>
// CHECK:         dxbc.utof r<0, <x>>, r<0, <x>>
// CHECK:         dxbc.unknown <tokens = [0x8A0000E2, 0x800002C2, 0x00199983, 0x0000D000, 0x00100012, 0x00000001, 0x0010100A, 0x00000000, 0x0011E006, 0x00000003]>
