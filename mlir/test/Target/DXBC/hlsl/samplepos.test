// RUN: mlir-translate --import-dxbc-bin %S/inputs/samplepos.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.unknown <tokens = [0x04002058, 0x00107000, 0x00000000, 0x00005555]>
// CHECK:         dxbc.unknown <tokens = [0x04004858, 0x00107000, 0x00000001, 0x00005555]>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <y, z, w>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_output o<1>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.ftoi r<0, <x, y, z>>, v<0, <z, w, y, z>>
// CHECK:         dxbc.unknown <tokens = [0x0800006E, 0x00100092, 0x00000000, 0x00107406, 0x00000000, 0x0010000A, 0x00000000, 0x00000000]>
// CHECK:         dxbc.unknown <tokens = [0x0800006E, 0x00100032, 0x00000001, 0x00107046, 0x00000001, 0x0010001A, 0x00000000, 0x00000000]>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 96 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand  {num_components = 4 : i32, swizzle = dense<[0, 0, 1, 0]> : vector<4xi32>, type = 14 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 2 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "samplepos" %[[OPERAND_0]], %[[OPERAND_1]], %[[OPERAND_2]]
// CHECK:         dxbc.add r<0, <x, w>>, r<0, <x, x, x, w>>, r<1, <x, x, x, y>>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_2]] {mask = 48 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxbc.operand  {num_components = 4 : i32, swizzle = dense<[0, 1, 0, 0]> : vector<4xi32>, type = 14 : i32}
// CHECK:         %[[OPERAND_5:.*]] = dxbc.operand.imm {imm = dense<3> : vector<1xi32>}
// CHECK:         dxbc.instruction "samplepos" %[[OPERAND_3]], %[[OPERAND_4]], %[[OPERAND_5]]
// CHECK:         dxbc.add r<0, <x, w>>, r<0, <x, x, x, w>>, r<1, <x, x, x, y>>
// CHECK:         dxbc.add r<0, <x, y>>, r<0, <y, z, y, y>>, r<0, <x, w, x, x>>
// CHECK:         dxbc.mov o<0, <x, y>>, r<0, <x, y, x, x>>
// CHECK:         dxbc.add o<1, <x, y>>, r<0, <x, y, x, x>>, l(0x40A00000, 0x40A00000, 0x0, 0x0)
// CHECK:         dxbc.mov o<0, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxbc.mov o<1, <z, w>>, l(0x0, 0x0, 0x40A00000, 0x40A00000)
// CHECK:         dxbc.ret

