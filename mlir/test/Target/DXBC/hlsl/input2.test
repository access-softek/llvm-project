// CHECK:         dxbc.dcl_input_ps_siv  linearNoPerspective v<6>, <position>
// CHECK:         dxbc.dcl_input_ps_sgv v<7, <x>>, <sampleIndex>
// CHECK:         dxbc.dcl_input_ps_sgv v<7, <y>>, <isFrontFace>
// CHECK:         dxbc.dcl_input vInnerCoverage
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.itof r<0>, v<1>
// CHECK:         dxbc.add r<0>, r<0>, v<0>
// CHECK:         dxbc.utof r<1>, v<2>
// CHECK:         dxbc.add r<0>, r<0>, r<1>
// CHECK:         dxbc.add r<0>, r<0>, v<3, min16f>
// CHECK:         dxbc.add r<0>, r<0>, v<4, <x, x, x, x>>
// CHECK:         dxbc.add r<0>, r<0>, v<4, <y, y, y, y>>
// CHECK:         dxbc.utof r<1, <x>>, vInnerCoverage<vector, <x>>
