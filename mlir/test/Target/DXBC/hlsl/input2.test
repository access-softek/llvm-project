// CHECK:         dxbc.utof r<1, <x>>, v<5, <z>>
// CHECK:         dxbc.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxbc.utof r<1, <x>>, v<5, <w>>
// CHECK:         dxbc.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxbc.add r<0>, r<0>, v<6>
