// RUN: mlir-translate --import-dxbc-bin %S/inputs/if3.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxbc.dcl_input_ps  constant v<1, <x>>
// CHECK:         dxbc.dcl_output o<0, <x>>
// CHECK:         dxbc.dcl_temps 1
// CHECK:         dxbc.ieq r<0, <x>>, v<1, <x>>, l(0x1)
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "if" %[[OPERAND_0]]
// CHECK:         dxbc.add o<0, <x>>, v<0, <x>>, l(0x40A00000)
// CHECK:         dxbc.else
// CHECK:         dxbc.add o<0, <x>>, v<0, <y>>, l(0xC29A0000)
// CHECK:         dxbc.endif
// CHECK:         dxbc.ret

