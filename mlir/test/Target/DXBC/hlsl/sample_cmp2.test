// RUN: mlir-translate --import-dxbc-bin %S/inputs/sample_cmp2.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_sampler <id = 5, mode =  comparison>
// CHECK:         dxbc.dcl_resource <id = 3>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.add r<0, <x>>, v<0, <x>>, v<0, <y>>
// CHECK:         dxbc.ftou r<0, <x>>, r<0, <x>>
// CHECK:         dxbc.utof r<0, <x>>, r<0, <x>>
// CHECK:         dxbc.sample_c_lz r<0, <y>>, v<0, <x, y, x, x>>, t<3, vector, <x, x, x, x>>, s<5>, r<0, <x>>
// CHECK:         dxbc.sample_c_lz r<0, <z>>, v<0, <x, y, x, x>>, t<3, vector, <x, x, x, x>>, s<5>, r<0, <x>>, <u = -5, v = 7, w = 0>
// CHECK:         dxbc.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxbc.sample_c_lz r<0, <z>>, v<0, <x, y, x, x>>, t<3, vector, <x, x, x, x>>, s<5>, r<0, <x>>, <u = -4, v = 1, w = 0>
// CHECK:         dxbc.unknown <tokens = [0x900000E5, 0x80005A01, 0x800000C2, 0x00155543, 0x00100012, 0x00000000, 0x00100012, 0x00000001, 0x00101046, 0x00000000, 0x00107006, 0x00000003, 0x00106000, 0x00000005, 0x0010000A, 0x00000000]>
// CHECK:         dxbc.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxbc.add r<0, <y>>, r<0, <x>>, r<0, <y>>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 64 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.utof r<0, <z>>, r<0, <z>>
// CHECK:         dxbc.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxbc.add r<0, <x>>, r<0, <x>>, r<0, <y>>
// CHECK:         dxbc.add o<0>, r<0, <z, z, z, z>>, r<0, <x, x, x, x>>
// CHECK:         dxbc.ret

