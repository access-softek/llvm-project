// RUN: mlir-translate --import-dxbc-bin %S/inputs/sample_cmp1.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_sampler <id = 5, mode =  comparison>
// CHECK:         dxbc.dcl_resource <id = 3>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 4
// CHECK:         dxbc.add r<0, <x>>, v<0, <x>>, v<0, <y>>
// CHECK:         dxbc.ftou r<0, <x>>, r<0, <x>>
// CHECK:         dxbc.utof r<0, <x>>, r<0, <x>>
// CHECK:         dxbc.unknown <tokens = [0x8D000046, 0x800000C2, 0x00155543, 0x00100022, 0x00000000, 0x00101046, 0x00000000, 0x00107006, 0x00000003, 0x00106000, 0x00000005, 0x0010000A, 0x00000000]>
// CHECK:         dxbc.unknown <tokens = [0x8E000046, 0x8000F601, 0x800000C2, 0x00155543, 0x00100042, 0x00000000, 0x00101046, 0x00000000, 0x00107006, 0x00000003, 0x00106000, 0x00000005, 0x0010000A, 0x00000000]>
// CHECK:         dxbc.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxbc.unknown <tokens = [0x910000E9, 0x80003801, 0x800000C2, 0x00155543, 0x00100012, 0x00000001, 0x0000D000, 0x00101046, 0x00000000, 0x00107006, 0x00000003, 0x00106000, 0x00000005, 0x0010000A, 0x00000000, 0x00004001, 0x3F000000]>
// CHECK:         dxbc.add r<0, <y>>, r<0, <y>>, r<1, <x>>
// CHECK:         dxbc.unknown <tokens = [0x920000E9, 0x80005A01, 0x800000C2, 0x00155543, 0x00100012, 0x00000001, 0x00100012, 0x00000002, 0x00101046, 0x00000000, 0x00107006, 0x00000003, 0x00106000, 0x00000005, 0x0010000A, 0x00000000, 0x00004001, 0x00000000]>
// CHECK:         dxbc.unknown <tokens = [0x920000E9, 0x80005A01, 0x800000C2, 0x00155543, 0x00100012, 0x00000000, 0x00100012, 0x00000003, 0x00101046, 0x00000000, 0x00107006, 0x00000003, 0x00106000, 0x00000005, 0x0010000A, 0x00000000, 0x0010100A, 0x00000000]>
// CHECK:         dxbc.add r<0, <y>>, r<0, <y>>, r<1, <x>>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 64 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.utof r<0, <z>>, r<0, <z>>
// CHECK:         dxbc.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxbc.add r<0, <x>>, r<0, <x>>, r<0, <y>>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {mask = 32 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_2]], %[[OPERAND_3]]
// CHECK:         dxbc.utof r<0, <y>>, r<0, <y>>
// CHECK:         dxbc.add o<0>, r<0, <y, y, y, y>>, r<0, <x, x, x, x>>
// CHECK:         dxbc.ret

