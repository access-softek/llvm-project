// RUN: mlir-translate --import-dxbc-bin %S/inputs/uav_typed_load_store1.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_uav_typed <id = 3, dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxbc.dcl_input_ps  constant v<0, <z, w>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.unknown <tokens = [0x890000A3, 0x800000C2, 0x00155543, 0x001000F2, 0x00000000, 0x00101FE6, 0x00000000, 0x0011EE46, 0x00000003]>
// CHECK:         dxbc.unknown <tokens = [0x890000A3, 0x800000C2, 0x00155543, 0x001000F2, 0x00000001, 0x00101546, 0x00000000, 0x0011EE46, 0x00000003]>
// CHECK:         dxbc.add r<0>, r<0>, r<1>
// CHECK:         dxbc.unknown <tokens = [0x8A0000E1, 0x800000C2, 0x00155543, 0x0000D000, 0x00100012, 0x00000001, 0x00101546, 0x00000000, 0x0011EE46, 0x00000003]>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxbc.mad r<0>, r<1, <x, x, x, x>>, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r<0>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {mask = 240 : i32, num_components = 4 : i32, type = 30 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, swizzle = dense<[2, 3, 3, 3]> : vector<4xi32>, type = 1 : i32}
// CHECK:         %[[INDEX_4:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxbc.operand %[[INDEX_4]] {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 3]> : vector<4xi32>, type = 0 : i32}
// CHECK:         dxbc.instruction "store_uav_typed" %[[OPERAND_2]], %[[OPERAND_3]], %[[OPERAND_4]]
// CHECK:         dxbc.mov o<0>, r<0>
// CHECK:         dxbc.ret

