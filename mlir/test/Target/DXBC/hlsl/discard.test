// RUN: mlir-translate --import-dxbc-bin %S/inputs/discard.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 1
// CHECK:         dxbc.lt r<0, <x>>, l(0x3E99999A), v<0, <x>>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "discard" %[[OPERAND_0]]
// CHECK:         dxbc.ne r<0, <x>>, v<0, <y>>, l(0x0)
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "discard" %[[OPERAND_1]]
// CHECK:         dxbc.mov o<0>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxbc.ret

