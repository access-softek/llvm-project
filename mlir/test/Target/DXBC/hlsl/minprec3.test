// RUN: mlir-translate --import-dxbc-bin %S/inputs/minprec3.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxbc.dcl_input_ps  constant v<0, min16i, <x>>
// CHECK:         dxbc.dcl_output o<0, <x>>
// CHECK:         dxbc.dcl_temps 2
// CHECK:         dxbc.iadd r<0, min16i, <x>>, v<0, min16i, <x>>, l(0x2)
// CHECK:         dxbc.ieq r<1, <x>>, r<0, min16i, <x>>, l(0x7)
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "if" %[[OPERAND_0]]
// CHECK:         dxbc.mov o<0, <x>>, l(0x4)
// CHECK:         dxbc.ret
// CHECK:         dxbc.else
// CHECK:         dxbc.mov o<0, <x>>, l(0x1)
// CHECK:         dxbc.ret
// CHECK:         dxbc.endif
// CHECK:         dxbc.ret

