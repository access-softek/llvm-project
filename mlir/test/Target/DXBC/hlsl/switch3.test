// CHECK:         dxbc.instruction "switch" %[[OPERAND_1]]
// CHECK:         dxbc.case l(0x14)
// CHECK:         dxbc.ieq r<0, <y>>, v<1, <z>>, l(0x1E)
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {num_components = 4 : i32, one = 1 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "if" %[[OPERAND_2]]
// CHECK:         dxbc.mov r<0, <x>>, l(0x40B00000)
// CHECK:         dxbc.break
// CHECK:         dxbc.endif
// CHECK:         dxbc.ieq r<0, <y>>, v<1, <z>>, l(0x1F)
// CHECK:         dxbc.mov r<0, <x>>, l(0x40B66666)
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 1 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "breakc" %[[OPERAND_3]]
// CHECK:         dxbc.mov r<0, <x>>, l(0x40B9999A)
// CHECK:         dxbc.break
// CHECK:         dxbc.default
// CHECK:         dxbc.mov r<0, <x>>, v<0, <y>>
// CHECK:         dxbc.break
// CHECK:         dxbc.endswitch
// CHECK:         dxbc.break
// CHECK:         dxbc.case l(0x2)
// CHECK:         dxbc.mov r<0, <x>>, v<0, <x>>
// CHECK:         dxbc.break
