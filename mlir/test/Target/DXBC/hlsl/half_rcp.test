// RUN: mlir-translate --import-dxbc-bin %S/inputs/half_rcp.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed|skipOptimization|enableMinimumPrecision>
