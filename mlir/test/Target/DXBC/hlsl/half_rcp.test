// CHECK:         dxbc.dcl_temps 1
// CHECK:         dxbc.mov r<0, min16f, <x>>, l(0x3F000000)
// CHECK:         dxbc.rcp r<0, min16f, <x>>, r<0, min16f, <x>>
// CHECK:         dxbc.mov o<0, <x>>, r<0, min16f, <x>>
// CHECK:         dxbc.ret

