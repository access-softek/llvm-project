// RUN: mlir-translate --import-dxbc-bin %S/inputs/call3.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxbc.dcl_input_ps  constant v<1, <x, y>>
// CHECK:         dxbc.dcl_output o<0, <x>>
// CHECK:         dxbc.dcl_temps 1
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {num_components = 4 : i32, one = 1 : i32, type = 1 : i32}
// CHECK:         dxbc.instruction "if" %[[OPERAND_0]]
// CHECK:         dxbc.mov o<0, <x>>, v<0, <y>>
// CHECK:         dxbc.ret
// CHECK:         dxbc.endif
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 1 : i32}
// CHECK:         dxbc.instruction "switch" %[[OPERAND_1]]
// CHECK:         dxbc.case l(0x1)
// CHECK:         dxbc.call label<0>
// CHECK:         dxbc.break
// CHECK:         dxbc.case l(0x2)
// CHECK:         dxbc.call label<1>
// CHECK:         dxbc.break
// CHECK:         dxbc.default
// CHECK:         dxbc.call label<2>
// CHECK:         dxbc.break
// CHECK:         dxbc.endswitch
// CHECK:         dxbc.mov o<0, <x>>, r<0, <x>>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {num_components = 4 : i32, one = 2 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "retc" %[[OPERAND_2]]
// CHECK:         dxbc.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxbc.ret
// CHECK:         dxbc.label label<0>
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 1 : i32, type = 1 : i32}
// CHECK:         dxbc.instruction "if" %[[OPERAND_3]]
// CHECK:         dxbc.mov r<0, <x>>, v<0, <y>>
// CHECK:         dxbc.mov r<0, <z>>, l(0xFFFFFFFF)
// CHECK:         dxbc.ret
// CHECK:         dxbc.endif
// CHECK:         dxbc.mov r<0, <y, z>>, l(0x0, 0x40A00000, 0x0, 0x0)
// CHECK:         dxbc.ret
// CHECK:         dxbc.label label<1>
// CHECK:         dxbc.mov r<0, <y>>, v<0, <x>>
// CHECK:         dxbc.mov r<0, <z>>, l(0x0)
// CHECK:         dxbc.ret
// CHECK:         dxbc.label label<2>
// CHECK:         dxbc.mov r<0, <y, z>>, l(0x0, 0x40400000, 0x0, 0x0)
// CHECK:         dxbc.ret

