// RUN: mlir-translate --import-dxbc-bin %S/inputs/sample_grad1.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_sampler <id = 5, mode =  default>
// CHECK:         dxbc.dcl_resource <id = 3>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxbc.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         dxbc.dcl_temps 3
// CHECK:         dxbc.sample_d r<0>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>
// CHECK:         dxbc.sample_d r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <u = -5, v = 7, w = 0>
// CHECK:         dxbc.add r<0>, r<0>, r<1>
// CHECK:         dxbc.sample_d_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <l(0x3F000000), null>, <u = -4, v = 1, w = 0>
// CHECK:         dxbc.add r<0>, r<0>, r<1>
// CHECK:         dxbc.sample_d_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <l(0x0), r<2, <x>>>, <u = -3, v = 2, w = 0>
// CHECK:         dxbc.add r<0>, r<0>, r<1>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxbc.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxbc.sample_d_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <v<0, <x>>, r<2, <x>>>, <u = -3, v = 2, w = 0>
// CHECK:         dxbc.add r<0>, r<0>, r<1>
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxbc.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand %[[INDEX_3]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "check_access_fully_mapped" %[[OPERAND_2]], %[[OPERAND_3]]
// CHECK:         dxbc.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxbc.add o<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxbc.ret

