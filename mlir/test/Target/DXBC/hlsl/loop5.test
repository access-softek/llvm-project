// CHECK:         dxbc.mov o<0, <x>>, r<0, <y>>
// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 3 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "retc" %[[OPERAND_1]]
// CHECK:         dxbc.ieq r<0, <w>>, r<0, <x>>, l(0x7)
// CHECK:         %[[INDEX_2:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand %[[INDEX_2]] {num_components = 4 : i32, one = 3 : i32, type = 0 : i32}
// CHECK:         dxbc.instruction "if" %[[OPERAND_2]]
// CHECK:         dxbc.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxbc.ret
// CHECK:         dxbc.endif
// CHECK:         dxbc.add r<0, <y>>, r<0, <y>>, v<0, <x>>
// CHECK:         dxbc.iadd r<0, <z>>, r<0, <z>>, l(0x1)
// CHECK:         dxbc.endloop
// CHECK:         dxbc.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxbc.ret

