// CHECK:         %[[INDEX_1:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxbc.operand.imm {imm = dense<0> : vector<1xi32>}
// CHECK:         %[[OPERAND_3:.*]] = dxbc.operand.imm {imm = dense<1065353216> : vector<1xi32>}
// CHECK:         dxbc.instruction "movc" %[[OPERAND_0]], %[[OPERAND_1]], %[[OPERAND_2]], %[[OPERAND_3]]
