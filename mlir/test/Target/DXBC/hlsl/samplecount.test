// RUN: mlir-translate --import-dxbc-bin %S/inputs/samplecount.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed>
// CHECK:         dxbc.dcl_output o<0>
// CHECK:         %[[INDEX_0:.*]] = dxbc.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxbc.operand %[[INDEX_0]] {mask = 48 : i32, num_components = 4 : i32, type = 2 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxbc.operand  {num_components = 4 : i32, one = 0 : i32, type = 14 : i32}
// CHECK:         dxbc.instruction "sampleinfo" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxbc.mov o<0, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxbc.ret

