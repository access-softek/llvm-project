// RUN: mlir-translate --import-dxbc-bin %S/inputs/ubfeu16.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxbc.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxbc.dcl_constant_buffer <id = 0, size = 1>, <immediateIndexed>
// CHECK:         dxbc.dcl_output o<0, min16u, <x>>
// CHECK:         dxbc.dcl_temps 1
// CHECK:         dxbc.ubfe r<0, min16u, <x>>, l(0x1B), l(0x5), cb<[0, 0], vector, min16u, <x>>
// CHECK:         dxbc.and r<0, min16u, <y>>, cb<[0, 0], vector, min16u, <x>>, l(0xFFFFFFFC)
// CHECK:         dxbc.xor r<0, min16u, <x>>, r<0, min16u, <x>>, r<0, min16u, <y>>
// CHECK:         dxbc.iadd o<0, min16u, <x>>, r<0, min16u, <x>>, r<0, min16u, <y>>
// CHECK:         dxbc.ret

