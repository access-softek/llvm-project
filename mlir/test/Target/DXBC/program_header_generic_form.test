// RUN: mlir-opt %s --mlir-print-op-generic --verify-roundtrip | FileCheck %s

// CHECK:      "dxbc.module"() <{major_version = 5 : i32, minor_version = 0 : i32, program_type = #dxbc<program_type pixel_shader>}> ({
// CHECK-NEXT:   "dxbc.dcl_global_flags"() <{flags = #dxbc.global_flags<refactoringAllowed>}> : () -> ()
// CHECK-NEXT:   "dxbc.add"() <{dst = #dxbc.dst_operand<r<0>>, lhs = #dxbc.src_operand<r<1>>, rhs = #dxbc.src_operand<r<2>>}> : () -> ()
dxbc.module pixel_shader 5 0 {
  dxbc.dcl_global_flags <refactoringAllowed>
  dxbc.add r<0>, r<1>, r<2>
}
