// RUN: mlir-translate --import-dxbc-hex %s | FileCheck %s
// RUN: mlir-translate --import-dxbc-hex %s | mlir-opt --verify-roundtrip

// CHECK:      dxbc.module {

// CHECK-NEXT:   dxbc.atomic_iadd u<0>, r<0>, r<1, <x>>
0x070000ad, 0x0011e000, 0x00000000, 0x00100e46, 0x00000000, 0x0010000a, 0x00000001

// CHECK-NEXT:   dxbc.atomic_iadd g<0>, r<2>, r<3, <x>>
0x070000ad, 0x0011f000, 0x00000000, 0x00100e46, 0x00000002, 0x0010000a, 0x00000003

// CHECK-NEXT: }
