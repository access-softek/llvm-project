// RUN: mlir-translate --import-dxbc-bin %S/inputs/dcl_output.bin | FileCheck %s

// CHECK-LABEL: module
module {
  // dcl_output o0.xyzw
  // CHECK:      %0 = dxbc.index.imm {imm = 0 : i32}
  // CHECK-NEXT: %1 = dxbc.operand %0 {mask = 240 : i32, num_components = 4 : i32, type = 2 : i32}
  // CHECK-NEXT: dxbc.dcl_output %1

  // dcl_output oDepth
  // CHECK-NEXT: %2 = dxbc.operand {num_components = 1 : i32, type = 12 : i32}
  // CHECK-NEXT: dxbc.dcl_output %2
}
