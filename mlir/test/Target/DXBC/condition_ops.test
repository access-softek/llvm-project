// RUN: mlir-translate --split-input-file --import-dxbc-hex %s | FileCheck %s
// RUN: mlir-translate --split-input-file --import-dxbc-hex %s | mlir-opt --split-input-file --verify-roundtrip

// CHECK-LABEL: dxbc.module {
// CHECK-NEXT:   dxbc.deq r<0, <x, y>>, -r<1, <z, w, x, y>>, -|r<2, <x, y, x, y>>|
// CHECK-NEXT: }
0x090000c3, 0x00100032, 0x00000000, 0x801004e6, 0x00000041, 0x00000001, 0x80100446, 0x000000c1, 0x00000002

// -----

// CHECK-LABEL: dxbc.module {
// CHECK-NEXT:   dxbc.deq precise <x, y> r<0, <x, y>>, r<1>, |r<2>|
// CHECK-NEXT: }
0x081800c3, 0x00100032, 0x00000000, 0x00100e46, 0x00000001, 0x80100e46, 0x00000081, 0x00000002

// -----

