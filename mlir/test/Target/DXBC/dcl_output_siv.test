// RUN: mlir-translate --import-dxbc-hex %s | FileCheck %s
// RUN: mlir-translate --import-dxbc-hex %s | mlir-opt --verify-roundtrip

// CHECK:      dxbc.module {

// CHECK-NEXT:   dxbc.dcl_output_siv o<0>, <position>
0x04000067, 0x001020f2, 0x00000000, 0x00000001

// CHECK-NEXT:   dxbc.dcl_output_siv o<1, <x>>, <clipDistance>
0x04000067, 0x00102012, 0x00000001, 0x00000002

// CHECK-NEXT: }
