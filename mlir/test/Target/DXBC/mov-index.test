// RUN: mlir-translate --import-dxbc-bin %S/inputs/mov-index.bin | FileCheck %s
// mov o0.xyzw, v[r0.x][0].xyzw

// CHECK:      dxbc.module {
// CHECK-NEXT:   %0 = dxbc.index.imm {imm = 0 : i32}
// CHECK-NEXT:   %1 = dxbc.operand %0 {mask = 240 : i32, num_components = 4 : i32, type = 2 : i32}
// CHECK-NEXT:   %2 = dxbc.index.imm {imm = 0 : i32}
// CHECK-NEXT:   %3 = dxbc.operand %2 {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK-NEXT:   %4 = dxbc.index.rel %3
// CHECK-NEXT:   %5 = dxbc.index.imm {imm = 0 : i32}
// CHECK-NEXT:   %6 = dxbc.operand %4, %5 {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 3]> : vector<4xi32>, type = 1 : i32}
// CHECK-NEXT:   dxbc.instruction "mov" %1, %6
// CHECK-NEXT: }
