// RUN: mlir-translate --import-dxbc-bin %S/inputs/dcl_sampler.bin | FileCheck %s
// RUN: mlir-translate --import-dxbc-bin %S/inputs/dcl_sampler.bin | mlir-opt --verify-roundtrip

// CHECK:      module {
