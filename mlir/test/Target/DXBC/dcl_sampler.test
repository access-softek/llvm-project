// CHECK-NEXT:   dxbc.dcl_sampler <id = 2, mode = mono>
// CHECK-NEXT:   dxbc.dcl_sampler <id = 0, mode = default, lbound = 0, ubound = 3, space = 1>
// CHECK-NEXT: }
