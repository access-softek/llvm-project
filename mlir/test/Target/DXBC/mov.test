// RUN: mlir-translate --import-dxbc-bin %S/inputs/mov.bin | FileCheck %s
// RUN: mlir-translate --import-dxbc-bin %S/inputs/mov.bin | mlir-opt --verify-roundtrip
// mov r0.x, l(3.000000)

// CHECK:      dxbc.module {
// CHECK-NEXT:   %0 = dxbc.index.imm {imm = 0 : i32}
// CHECK-NEXT:   %1 = dxbc.operand %0 {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK-NEXT:   %2 = dxbc.operand.imm {imm = dense<1077936128> : vector<1xi32>}
// CHECK-NEXT:   dxbc.instruction "mov" %1, %2
// CHECK-NEXT: }

module {
  %0 = dxbc.index.imm {imm = 0 : i32}
  %1 = dxbc.operand %0 {mask = 16 : i32, num_components = 4 : i32, type = 0 : i32}
  %2 = dxbc.operand.imm {imm = dense<1077936128> : vector<1xi32>}
  dxbc.instruction "mov" %1, %2
}
