// RUN: mlir-translate --import-dxbc-hex %s | FileCheck %s
// RUN: mlir-translate --import-dxbc-hex %s | mlir-opt --verify-roundtrip

// CHECK:      dxbc.module {

// CHECK-NEXT:   dxbc.ftoi r<0>, r<1>
0x0500001b, 0x001000f2, 0x00000000, 0x00100e46, 0x00000001

// CHECK-NEXT:   dxbc.ftoi r<0>, -r<1>
0x0600001b, 0x001000f2, 0x00000000, 0x80100e46, 0x00000041, 0x00000001

// CHECK-NEXT:   dxbc.ftoi r<0>, |r<1>|
0x0600001b, 0x001000f2, 0x00000000, 0x80100e46, 0x00000081, 0x00000001

// CHECK-NEXT:   dxbc.ftoi r<0>, -|r<1>|
0x0600001b, 0x001000f2, 0x00000000, 0x80100e46, 0x000000c1, 0x00000001

// CHECK-NEXT:   dxbc.ftoi r<0, <x>>, r<1, <y, z, w, y>>
0x0500001b, 0x00100012, 0x00000000, 0x00100796, 0x00000001

// CHECK-NEXT:   dxbc.ftoi precise <x, y> r<0>, r<1>
0x0518001b, 0x001000f2, 0x00000000, 0x00100e46, 0x00000001

// CHECK-NEXT: }
