// RUN: mlir-translate --import-dxsa-bin %S/inputs/ubfeu16.shex | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 1>, <immediateIndexed>
// CHECK:         dxsa.dcl_output o<0, min16u, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.ubfe r<0, min16u, <x>>, l(0x1B), l(0x5), cb<[0, 0], vector, min16u, <x>>
// CHECK:         dxsa.and r<0, min16u, <y>>, cb<[0, 0], vector, min16u, <x>>, l(0xFFFFFFFC)
// CHECK:         dxsa.xor r<0, min16u, <x>>, r<0, min16u, <x>>, r<0, min16u, <y>>
// CHECK:         dxsa.iadd o<0, min16u, <x>>, r<0, min16u, <x>>, r<0, min16u, <y>>
// CHECK:         dxsa.ret

