// CHECK:         %[[OPERAND_2:.*]] = dxsa.operand %[[INDEX_1]] {mask = 16 : i32, min_precision = 1 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_2:.*]] = dxsa.index.imm {imm = 0 : i32}
