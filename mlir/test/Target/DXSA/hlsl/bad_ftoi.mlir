// CHECK:         %[[OPERAND_1:.*]] = dxsa.operand.imm {imm = dense<2139095039> : vector<1xi32>}
// CHECK:         dxsa.instruction "ftou" %[[OPERAND_0]], %[[OPERAND_1]]
