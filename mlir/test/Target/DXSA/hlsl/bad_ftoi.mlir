// CHECK:         %[[OPERAND_2:.*]] = dxsa.operand %[[INDEX_1]] {mask = 128 : i32, num_components = 4 : i32, type = 2 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxsa.operand.imm {imm = dense<-8388609> : vector<1xi32>}
// CHECK:         dxsa.instruction "ftou" %[[OPERAND_2]], %[[OPERAND_3]]
// CHECK:         %[[INDEX_2:.*]] = dxsa.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxsa.operand %[[INDEX_2]] {mask = 48 : i32, num_components = 4 : i32, type = 2 : i32}
// CHECK:         %[[OPERAND_5:.*]] = dxsa.operand.imm {imm = dense<[2139095039, -8388609, 0, 0]> : vector<4xi32>}
// CHECK:         dxsa.instruction "ftoi" %[[OPERAND_4]], %[[OPERAND_5]]
