// CHECK:         dxsa.mad r<0>, vpc<3, <x, x, x, x>>, l(0x40800000, 0x40800000, 0x40800000, 0x40800000), r<0>
// CHECK:         dxsa.add r<1, <x>>, vpc<4, <x>>, vpc<5, <x>>
