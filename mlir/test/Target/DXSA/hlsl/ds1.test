// CHECK:         dxsa.iadd r<1, <x>>, r<1, <x>>, l(0x1)
// CHECK:         dxsa.endloop
// CHECK:         dxsa.add r<0>, r<0>, vpc<0, <x, x, x, x>>
// CHECK:         dxsa.mad r<0>, vpc<1, <x, x, x, x>>, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r<0>
