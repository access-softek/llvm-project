// CHECK:         dxsa.ige r<1, <y>>, r<1, <x>>, l(0x10)
// CHECK:         %[[INDEX_0:.*]] = dxsa.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxsa.operand %[[INDEX_0]] {num_components = 4 : i32, one = 1 : i32, type = 0 : i32}
// CHECK:         dxsa.instruction "breakc" %[[OPERAND_0]]
