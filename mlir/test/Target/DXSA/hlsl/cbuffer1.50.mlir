// CHECK:         %[[INDEX_1:.*]] = dxsa.index.imm {imm = 5 : i32}
// CHECK:         %[[INDEX_2:.*]] = dxsa.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_1:.*]] = dxsa.operand %[[INDEX_1]], %[[INDEX_2]] {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 3]> : vector<4xi32>, type = 8 : i32}
// CHECK:         dxsa.instruction "mov" %[[OPERAND_0]], %[[OPERAND_1]]
// CHECK:         dxsa.instruction "ret"

