// CHECK:         dxsa.gather4_c r<1>, v<0, <x, y, x, x>>, t<0, vector>, s<0, vector, <y>>, v<0, <y>>, <u = -5, v = 7, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
