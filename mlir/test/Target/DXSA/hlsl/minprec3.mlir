// CHECK:         %[[OPERAND_5:.*]] = dxsa.operand %[[INDEX_4]] {min_precision = 4 : i32, num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         %[[OPERAND_6:.*]] = dxsa.operand.imm {imm = dense<7> : vector<1xi32>}
// CHECK:         dxsa.instruction "ieq" %[[OPERAND_4]], %[[OPERAND_5]], %[[OPERAND_6]]
// CHECK:         %[[INDEX_5:.*]] = dxsa.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_7:.*]] = dxsa.operand %[[INDEX_5]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxsa.instruction "if" %[[OPERAND_7]]
