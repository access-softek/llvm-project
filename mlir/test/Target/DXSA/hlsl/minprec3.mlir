// CHECK:         %[[OPERAND_2:.*]] = dxsa.operand %[[INDEX_2]] {min_precision = 4 : i32, num_components = 4 : i32, one = 0 : i32, type = 1 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxsa.operand.imm {imm = dense<2> : vector<1xi32>}
// CHECK:         dxsa.instruction "iadd" %[[OPERAND_1]], %[[OPERAND_2]], %[[OPERAND_3]]
